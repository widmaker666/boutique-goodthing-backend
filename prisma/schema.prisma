// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  nom                String?
  prenom             String?
  password           String
  plan               Plan             @default(FREE)
  role               Role             @default(CREATRICE)
  lastExportData     DateTime?
  createdAt          DateTime         @default(now())
  refreshToken       String?
  boutiques          Boutique[]
  boutiqueMembers    BoutiqueMember[]
  creatrices         Creatrice[]      @relation("CreatriceCompte")
  creatricesGerees   Creatrice[]      @relation("CreatriceGerante")
  notificationsEmail Boolean          @default(true)
  stripeCustomerId   String?
  avatar             String?
  notifications      Notification[]
  cguAcceptedAt      DateTime?
}

model Boutique {
  id              String           @id @default(uuid())
  nom             String
  email           String?
  telephone       String?
  createdAt       DateTime         @default(now())
  gerante         User             @relation(fields: [geranteId], references: [id])
  geranteId       String
  boutiqueMembers BoutiqueMember[]
  ventes          Vente[]
}

model Evenement {
  id          String    @id @default(uuid())
  nom         String
  dateDebut   DateTime
  dateFin     DateTime?
  createdAt   DateTime  @default(now())
  creatrice   Creatrice @relation(fields: [creatriceId], references: [id])
  creatriceId String
  ventes      Vente[]
  articles    Article[]
}

model BoutiqueMember {
  id               String   @id @default(uuid())
  member           User     @relation(fields: [memberId], references: [id])
  memberId         String
  boutiqueMember   Boutique @relation(fields: [boutiqueMemberId], references: [id])
  boutiqueMemberId String
  planMember       Plan     @default(FREE)
  createdAt        DateTime @default(now())
  status           Status   @default(INVITE)

  @@unique([memberId, boutiqueMemberId])
}

model Creatrice {
  id               String      @id @default(uuid())
  nom              String
  email            String?
  telephone        String?
  tauxDeCommission Float
  createdAt        DateTime    @default(now())
  vente            Vente[]
  user             User?       @relation("CreatriceCompte", fields: [userId], references: [id])
  userId           String?     @unique
  gerante          User        @relation("CreatriceGerante", fields: [geranteId], references: [id])
  geranteId        String
  evenements       Evenement[]
  articles         Article[]

  @@index([geranteId])
}

model Article {
  id            String     @id @default(uuid())
  nom           String
  description   String?
  prixIndicatif Float?
  quantite      Int?       @default(0)
  photo         String?
  createdAt     DateTime   @default(now())
  creatrice     Creatrice? @relation(fields: [creatriceId], references: [id], onDelete: Cascade)
  creatriceId   String?
  evenement     Evenement? @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  evenementId   String?

  @@unique([nom, creatriceId])
  @@unique([nom, evenementId])
}

model Vente {
  id           String       @id @default(uuid())
  photo        String?
  nomArticle   String
  prixVente    Float
  quantite     Int          @default(1)
  modePaiement ModePaiement
  createdAt    DateTime     @default(now())
  creatrice    Creatrice    @relation(fields: [creatriceId], references: [id])
  creatriceId  String
  boutique     Boutique?    @relation(fields: [boutiqueId], references: [id])
  boutiqueId   String?
  evenement    Evenement?   @relation(fields: [evenementId], references: [id])
  evenementId  String?
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  metadata  Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum ModePaiement {
  ESPECES
  CARTE
}

enum Plan {
  FREE
  PRO
  DUO
}

enum Role {
  CREATRICE
  GERANTE
  GERANTE_CREATRICE
}

enum Status {
  ACTIVE
  INVITE
  SUSPENDUE
}
