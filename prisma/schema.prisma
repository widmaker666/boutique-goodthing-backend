// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  nom                String?
  prenom             String?
  password           String
  plan               Plan             @default(FREE)
  role               Role             @default(CREATRICE)
  lastExportData     DateTime?
  createdAt          DateTime         @default(now())
  refreshToken       String?
  boutiques          Boutique[]
  boutiqueMembers    BoutiqueMember[]
  creatrices         Creatrice[]
  notificationsEmail Boolean          @default(true)
  stripeCustomerId   String?
}

model Boutique {
  id              String           @id @default(uuid())
  nom             String
  email           String?
  telephone       String?
  createdAt       DateTime         @default(now())
  gerante         User             @relation(fields: [geranteId], references: [id])
  geranteId       String
  boutiqueMembers BoutiqueMember[]
  ventes          Vente[]
}

model BoutiqueMember {
  id               String   @id @default(uuid())
  member           User     @relation(fields: [memberId], references: [id])
  memberId         String
  boutiqueMember   Boutique @relation(fields: [boutiqueMemberId], references: [id])
  boutiqueMemberId String
  planMember       Plan     @default(FREE)
  createdAt        DateTime @default(now())
  status           Status   @default(INVITE)

  @@unique([memberId, boutiqueMemberId])
}

model Creatrice {
  id               String   @id @default(uuid())
  nom              String
  email            String?
  telephone        String?
  tauxDeCommission Float
  createdAt        DateTime @default(now())
  vente            Vente[]
  user             User?    @relation(fields: [userId], references: [id])
  userId           String?
}

model Vente {
  id           String       @id @default(uuid())
  photo        String?
  nomArticle   String
  prixVente    Float
  modePaiement ModePaiement
  createdAt    DateTime     @default(now())
  creatrice    Creatrice    @relation(fields: [creatriceId], references: [id])
  creatriceId  String
  boutique     Boutique?    @relation(fields: [boutiqueId], references: [id])
  boutiqueId   String?
}

enum ModePaiement {
  ESPECES
  CARTE
}

enum Plan {
  FREE
  PRO
}

enum Role {
  CREATRICE
  GERANTE
}

enum Status {
  ACTIVE
  INVITE
  SUSPENDUE
}
